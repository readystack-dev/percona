# ReadyStack MySQL configuration, read by mysqld and the bundled clients.
# Add settings in a .cnf file mounted into /etc/mysql/conf.d/ (read after this file).
[mysqld]
datadir=/var/lib/mysql
socket=/var/run/mysqld/mysqld.sock
pid-file=/var/run/mysqld/mysqld.pid
loose-mysqlx-socket=/var/run/mysqld/mysqlx.sock
skip-name-resolve
host-cache-size=0

[client]
socket=/var/run/mysqld/mysqld.sock

!includedir /etc/mysql/conf.d/
